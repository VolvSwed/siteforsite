{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vyraz-by",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-03",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vyraz-content",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
